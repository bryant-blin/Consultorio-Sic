:root {
    --ficha-primary: #1e293b;
    --ficha-accent: #334155;
    --ficha-gray: #64748b;
    --ficha-border: #cbd5e1;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background-color: #f1f5f9;
    color: var(--ficha-primary);
    line-height: 1.5;
}

/* Contenedor principal estilo hoja */
.hoja-ficha {
    background: white;
    width: 210mm;
    min-height: 297mm;
    margin: 20px auto;
    padding: 20mm;
    position: relative;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    z-index: 1;
    display: flex;
    flex-direction: column;
}

/* Marca de Agua */
.watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    height: auto;
    opacity: 0.05;
    z-index: -1;
    pointer-events: none;
}

/* Encabezado Institucional */
.header-institucional {
    display: flex;
    align-items: center;
    margin-bottom: 30px;
    border-bottom: 2px solid var(--ficha-primary);
    padding-bottom: 15px;
}

.logo-header {
    width: 80px;
    height: 80px;
    object-fit: contain;
}

.titulo-institucion {
    flex-grow: 1;
    text-align: center;
    padding: 0 20px;
}

.titulo-institucion h2 {
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.titulo-institucion p {
    font-size: 12px;
    color: var(--ficha-gray);
    font-weight: 600;
}

/* Título del Documento */
.doc-title {
    text-align: center;
    margin-bottom: 25px;
}

.doc-title h1 {
    font-size: 22px;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 8px;
}

/* Secciones Formales */
.seccion-formal {
    margin-bottom: 25px;
}

.seccion-title {
    font-size: 14px;
    font-weight: 800;
    background: #f8fafc;
    padding: 5px 10px;
    border-left: 5px solid var(--ficha-primary);
    margin-bottom: 15px;
    text-transform: uppercase;
}

/* Grid de datos (estilo líneas) */
.datos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px 30px;
}

.dato-item {
    font-size: 13px;
    border-bottom: 1px dotted var(--ficha-border);
    padding-bottom: 3px;
    display: flex;
}

.dato-label {
    font-weight: 700;
    margin-right: 10px;
    min-width: 100px;
    color: var(--ficha-accent);
}

.dato-valor {
    color: var(--ficha-primary);
}

/* Bloques de Texto Largo */
.bloque-texto {
    font-size: 13px;
    margin-top: 10px;
    line-height: 1.6;
    white-space: pre-wrap;
    text-align: justify;
}

/* Firma */
.firma-footer {
    margin-top: auto;
    padding-top: 50px;
    display: flex;
    justify-content: center;
}

.firma-wrap {
    text-align: center;
    width: 300px;
}

.firma-linea {
    border-top: 1px solid var(--ficha-primary);
    margin-bottom: 5px;
}

.firma-wrap p {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
}

/* Ajustes de Impresión */
@media print {
    .no-imprimir { display: none !important; }
    body { background: white !important; }
    .hoja-ficha {
        margin: 0 !important;
        box-shadow: none !important;
        width: 100% !important;
        height: auto !important;
    }
    .watermark {
        opacity: 0.08 !important;
    }
}
